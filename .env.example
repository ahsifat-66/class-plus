# ==============================================================================
# ClassPulse - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure the variables for local development or Vercel.

# 1. Database Configuration (Neon PostgreSQL)
DATABASE_URL="postgresql://username:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Authentication Secrets
JWT_SECRET="generate_a_secure_random_string_for_jwt_session_signing_min_32_chars"
TEACHER_ACCESS_CODE="TEACHER2024"

# 3. Google Gemini AI (Academic Locker practice quizzes & flashcards)
GEMINI_API_KEY=""

# ==============================================================================
# 4. Email OTP Verification Service (CHOOSE ONE OPTION)
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION A: Resend (RECOMMENDED for Vercel & Production)
# ------------------------------------------------------------------------------
# 1. Sign up for free at https://resend.com
# 2. Generate an API Key under API Keys tab
# 3. For testing, use the default sender: onboarding@resend.dev
# 4. For production, verify your custom domain in Resend DNS settings.
RESEND_API_KEY=""
RESEND_FROM="ClassPulse <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# OPTION B: Gmail SMTP / Google App Password (Alternative)
# ------------------------------------------------------------------------------
# 1. Go to your Google Account (https://myaccount.google.com/)
# 2. Enable 2-Step Verification (Security -> 2-Step Verification)
# 3. Generate an "App Password" (Search 'App passwords' in Google Account search)
# 4. Name it "ClassPulse" and copy the 16-character password generated.
# NOTE: Do NOT use your regular Gmail account password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your_16_char_app_password"
SMTP_FROM="\"ClassPulse\" <your-email@gmail.com>"

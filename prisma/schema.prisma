generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TEACHER
  STUDENT
}

model User {
  id             String            @id @default(cuid())
  uniqueId       String?           @unique
  name           String
  email          String            @unique
  password       String
  role           Role              @default(STUDENT)
  avatar         String?
  avatarUrl      String?
  institution    String?
  grade          String?
  bio            String?
  createdCourses Classroom[]       @relation("TeacherCourses")
  memberships    ClassroomMember[]
  enrollments    Enrollment[]
  messages       Message[]
  announcements  Announcement[]
  submissions    Submission[]
  personalNotes  PersonalNote[]
  studyLogs      StudyLog[]
  personalGoals  PersonalGoal[]
  notes          ClassroomNote[]
  notifications  Notification[]
  quizSubmissions QuizSubmission[]
  isVerified     Boolean           @default(false)
  emailOtps      EmailOtp[]
  createdAt      DateTime          @default(now())

  @@index([email])
}

model Classroom {
  id            String            @id @default(cuid())
  name          String
  subject       String
  code          String            @unique
  teacherId     String
  teacher       User              @relation("TeacherCourses", fields: [teacherId], references: [id], onDelete: Cascade)
  members       ClassroomMember[]
  enrollments   Enrollment[]
  announcements Announcement[]
  assignments   Assignment[]
  channels      Channel[]
  notes         ClassroomNote[]
  quizzes       Quiz[]
  gradeLevel    String?
  textbooks     NctbBook[]
  createdAt     DateTime          @default(now())
}

model ClassroomMember {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  role        Role      @default(STUDENT)
  createdAt   DateTime  @default(now())

  @@unique([userId, classroomId])
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userId, classroomId])
}

model Channel {
  id             String    @id @default(cuid())
  name           String    // e.g. "general", "doubt-solving", "resources"
  postPermission String    @default("EVERYONE") // "EVERYONE" | "TEACHERS_ONLY"
  classroomId    String
  classroom      Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  messages       Message[]
  createdAt      DateTime  @default(now())
}

model Message {
  id        String   @id @default(cuid())
  content   String
  isEdited  Boolean  @default(false)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  content     String
  isEdited    Boolean   @default(false)
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
}

model Assignment {
  id                 String       @id @default(cuid())
  title              String
  description        String
  dueDate            DateTime
  maxPoints          Int
  assignToAll        Boolean      @default(true)
  assignedStudentIds String[]     @default([])
  classroomId        String
  classroom          Classroom    @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  submissions        Submission[]
  createdAt          DateTime     @default(now())
}

model ClassroomNote {
  id          String    @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  subject     String
  content     String?   @db.Text
  fileUrl     String?
  fileName    String?
  driveUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([classroomId])
  @@index([userId])
  @@index([subject])
}

model Submission {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  content      String
  grade        Int?
  feedback     String?
  submittedAt  DateTime   @default(now())

  @@unique([assignmentId, studentId])
}

model PersonalNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String   @db.Text
  subject   String
  tags      String[]
  fileUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([subject])
}

model StudyLog {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject         String
  durationMinutes Int
  date            DateTime @default(now())
  notes           String?
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([date])
}

model PersonalGoal {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  targetDate  DateTime
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
}

model EmailOtp {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  code      String
  type      String   @default("SIGNUP") // "SIGNUP" | "RESET_PASSWORD"
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([email])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model Quiz {
  id               String           @id @default(cuid())
  classroomId      String
  classroom        Classroom        @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  timeLimitMinutes Int              @default(15)
  dueDate          DateTime?
  createdAt        DateTime         @default(now())
  questions        QuizQuestion[]
  submissions      QuizSubmission[]

  @@index([classroomId])
}

model QuizQuestion {
  id                 String   @id @default(cuid())
  quizId             String
  quiz               Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question           String
  options            String[]
  correctOptionIndex Int
  points             Int      @default(1)

  @@index([quizId])
}

model QuizSubmission {
  id              String   @id @default(cuid())
  quizId          String
  quiz            Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  selectedAnswers Int[]
  score           Int
  totalPoints     Int
  completedAt     DateTime @default(now())

  @@unique([quizId, userId])
  @@index([quizId])
  @@index([userId])
}

model NctbBook {
  id         String      @id @default(cuid())
  grade      String      // e.g. "Class 1", "Class 6", "Class 9-10", "Class 11-12"
  subject    String      // e.g. "Bangla", "Mathematics", "Science"
  title      String
  version    String      @default("bangla")
  driveUrl   String?
  coverImage String?
  classrooms Classroom[]
  createdAt  DateTime    @default(now())

  @@index([grade])
  @@index([subject])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String?  @default("guest")
  userName  String?  @default("Anonymous User")
  userEmail String?  @default("N/A")
  uniqueId  String?  @default("N/A")
  userRole  String?  @default("student")
  category  String   @default("general") // 'suggestion' | 'bug' | 'general'
  message   String   @db.Text
  status    String   @default("new")     // 'new' | 'reviewed'
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([status])
  @@index([category])
  @@index([createdAt])
}


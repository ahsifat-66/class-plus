generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TEACHER
  STUDENT
}

model User {
  id             String            @id @default(cuid())
  name           String
  email          String            @unique
  password       String
  role           Role              @default(STUDENT)
  avatar         String?
  avatarUrl      String?
  institution    String?
  grade          String?
  bio            String?
  createdCourses Classroom[]       @relation("TeacherCourses")
  memberships    ClassroomMember[]
  enrollments    Enrollment[]
  messages       Message[]
  announcements  Announcement[]
  submissions    Submission[]
  personalNotes  PersonalNote[]
  studyLogs      StudyLog[]
  personalGoals  PersonalGoal[]
  isVerified     Boolean           @default(false)
  emailOtps      EmailOtp[]
  createdAt      DateTime          @default(now())

  @@index([email])
}

model Classroom {
  id            String            @id @default(cuid())
  name          String
  subject       String
  code          String            @unique
  teacherId     String
  teacher       User              @relation("TeacherCourses", fields: [teacherId], references: [id], onDelete: Cascade)
  members       ClassroomMember[]
  enrollments   Enrollment[]
  announcements Announcement[]
  assignments   Assignment[]
  channels      Channel[]
  createdAt     DateTime          @default(now())
}

model ClassroomMember {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  role        Role      @default(STUDENT)
  createdAt   DateTime  @default(now())

  @@unique([userId, classroomId])
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userId, classroomId])
}

model Channel {
  id          String    @id @default(cuid())
  name        String    // e.g. "general", "doubt-solving", "resources"
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  messages    Message[]
  createdAt   DateTime  @default(now())
}

model Message {
  id        String   @id @default(cuid())
  content   String
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  content     String
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
}

model Assignment {
  id          String       @id @default(cuid())
  title       String
  description String
  dueDate     DateTime
  maxPoints   Int
  classroomId String
  classroom   Classroom    @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  submissions Submission[]
  createdAt   DateTime     @default(now())
}

model Submission {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  content      String
  grade        Int?
  feedback     String?
  submittedAt  DateTime   @default(now())

  @@unique([assignmentId, studentId])
}

model PersonalNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String   @db.Text
  subject   String
  tags      String[]
  fileUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([subject])
}

model StudyLog {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject         String
  durationMinutes Int
  date            DateTime @default(now())
  notes           String?
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([date])
}

model PersonalGoal {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  targetDate  DateTime
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
}

model EmailOtp {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  code      String
  type      String   @default("SIGNUP") // "SIGNUP" | "RESET_PASSWORD"
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([email])
}
